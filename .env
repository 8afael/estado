# -----------------------------------------------------------------------
# Feature flags -- controle de edição de avaliações já concluídas
# -----------------------------------------------------------------------
# true  -> avaliações com status "Concluído" ficam somente leitura pra
#          TODOS os usuários (o botão "Editar Avaliação" vira indicador
#          de somente-leitura, sem link).
# false -> comportamento atual, qualquer um pode reabrir e editar.

# Etapa 1 (triagem -- artigos_lista.html / avaliacao.html)
BLOQUEAR_EDICAO_AVALIACAO_1=true

# Etapa 2 / 3º avaliador (artigos_lista3.html / avaliacao3.html)
# Deixe "false" por enquanto -- você disse que essa é a próxima etapa.
BLOQUEAR_EDICAO_AVALIACAO_3=false